{% from 'ogm-desktop-entry.j2' import ogm_metadata with context -%}
[Desktop Entry]
Name=Streets of Rage Remake (on {{ dg_box_name }})
{# Host gamescope: start the launcher on the host so it can run gamescope
   there and enter the box inside it (no distrobox-host-exec needed). #}
{% if dg_sorr_host_gamescope | bool %}
Exec={{ dg_box_home }}/bin/sorr-launch
{% else %}
Exec=/usr/bin/distrobox-enter -n {{ dg_box_name }} -- {{ dg_box_home }}/bin/sorr-launch
{% endif %}
Terminal=false
Type=Application
Icon=wine
Comment=Streets of Rage Remake v5.2 (BomberGames) via Wine in {{ dg_box_name }}
Categories=Game;
StartupWMClass=sorr.exe;
{{ ogm_metadata('streets-of-rage-remake') }}

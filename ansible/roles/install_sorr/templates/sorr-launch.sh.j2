#!/usr/bin/env sh
set -eu

# Streets of Rage Remake v5.2 launcher. Runs SorR.exe under Wine with the
# shared pad policy, on the main horizontal monitor. The pad's Guide button
# (or Select+Start) stops the game and returns to ES-DE via
# dg-pad-exit-watch. Managed by install_sorr.
#
# Usage:
#   sorr-launch          # launch the game
#   sorr-launch <arg>    # same (ES-DE would pass %ROM%; ignored)
#   sorr-launch status   # print install / prefix / pad status
#   sorr-launch stop     # stop the running game (what Guide triggers)

work_dir="{{ dg_sorr_work_dir }}"
prefix="{{ dg_sorr_prefix }}"
exe="{{ dg_sorr_exe }}"
main_output="${DG_MAIN_OUTPUT:-{{ dg_sorr_main_output }}}"

common_env() {
  # Same SDL environment as the other Wine game launchers: pad seen
  # unfocused, no hidapi double-open, only real pads exposed.
  export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1
  export SDL_JOYSTICK_HIDAPI="${SDL_JOYSTICK_HIDAPI:-{{ dg_pc_racing_sdl_hidapi }}}"
  export SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT="${SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT:-{{ dg_pc_racing_gamepad_only }}}"
}

focus_main_output() {
  # Open on the main HORIZONTAL monitor, never the portrait one. hyprctl
  # isn't in the box and distrobox-host-exec can't reach it, but the
  # Hyprland socket is shared in, so talk to it with python3. Best-effort.
  if command -v python3 >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    python3 - "$main_output" <<'PY' >/dev/null 2>&1 || true
import socket, os, sys
sig = os.environ["HYPRLAND_INSTANCE_SIGNATURE"]; xdg = os.environ["XDG_RUNTIME_DIR"]
s = socket.socket(socket.AF_UNIX); s.connect(f"{xdg}/hypr/{sig}/.socket.sock")
s.sendall(f"dispatch focusmonitor {sys.argv[1]}".encode()); s.recv(64)
PY
  fi
}

kill_prefix_procs() {
  # wineserver -k misses Wine processes orphaned from their server, e.g. after
  # the host gamescope session they drew into went away. Those keep the host
  # gamescope reaper (and so ES-DE, which waits on it) alive and make the next
  # launch attach to a dead display. Find them by WINEPREFIX instead.
  for d in /proc/[0-9]*; do
    [ "${d#/proc/}" = "$$" ] && continue
    # Braces so 2>/dev/null also covers the redirect: other users'
    # /proc/<pid>/environ is unreadable and would print "Permission denied".
    if { tr '\0' '\n' < "$d/environ"; } 2>/dev/null | grep -qxF "WINEPREFIX=$prefix"; then
      kill -9 "${d#/proc/}" 2>/dev/null || true
    fi
  done
}

run_game() {
  common_env
  focus_main_output
  kill_prefix_procs
  export WINEPREFIX="$prefix" WINEARCH={{ dg_sorr_winearch }} WINEDEBUG="${WINEDEBUG:--all}"
  cd "$work_dir"
  use_gamescope="${DG_SORR_GAMESCOPE-{{ dg_sorr_use_gamescope | ternary('1', '') }}}"
  gamescope_opts="${DG_SORR_GAMESCOPE_OPTS-{{ dg_sorr_gamescope_opts }}}"
  desktop_res="${DG_SORR_DESKTOP_RES-{{ dg_sorr_desktop_res }}}"
  if [ -n "$use_gamescope" ] && command -v gamescope >/dev/null 2>&1; then
    # gamescope upscales SorR.exe's fixed ~640x480 output to true fullscreen
    # (keep SORR itself in WINDOWED mode). --immediate-flips + --rt reduce
    # the compositor input latency. Set DG_SORR_GAMESCOPE=0 to disable.
    # shellcheck disable=SC2086
    env -u PYTHONHOME -u PYTHONPATH gamescope $gamescope_opts -- wine "$exe"
  elif [ -n "$desktop_res" ]; then
    # No gamescope: give SORR a Wine virtual desktop to fill.
    env -u PYTHONHOME -u PYTHONPATH wine explorer /desktop=sorr,"$desktop_res" "$exe"
  else
    env -u PYTHONHOME -u PYTHONPATH wine "$exe"
  fi
}

stop_game() {
  WINEPREFIX="$prefix" env -u PYTHONHOME -u PYTHONPATH wineserver -k >/dev/null 2>&1 || true
  kill_prefix_procs
}

run_with_exit_chord() {
  evsieve_pid=""
  if [ -x "$HOME/bin/dg-pad-exit-watch" ]; then
    # Guide or Select+Start on any pad stops the game. No grab and no
    # uinput needed (the old Alt+F4 key injection required /dev/uinput).
    "$HOME/bin/dg-pad-exit-watch" "{{ dg_box_home }}/bin/sorr-launch stop" >/dev/null 2>&1 &
    evsieve_pid=$!
  fi
  cleanup() {
    [ -n "$evsieve_pid" ] && kill "$evsieve_pid" 2>/dev/null || true
    stop_game
  }
  trap cleanup EXIT HUP INT TERM
  set +e
  run_game
  status=$?
  set -e
  trap - EXIT HUP INT TERM
  cleanup
  return "$status"
}

status() {
  printf '%s\n' 'Streets of Rage Remake v5.2 status'
  [ -f "{{ dg_sorr_archive }}" ] && sha1sum "{{ dg_sorr_archive }}" || printf 'archive missing\n'
  [ -f "$work_dir/$exe" ] && printf 'exe present: %s\n' "$work_dir/$exe" || printf 'exe MISSING: %s\n' "$work_dir/$exe"
  [ -f "$prefix/system.reg" ] && printf 'prefix ready: %s\n' "$prefix" || printf 'prefix MISSING\n'
  ls /dev/input/js* 2>/dev/null || printf '%s\n' 'no /dev/input/js controller visible (wake the pad before launching)'
}

run_in_host_gamescope() {
  # Re-enter this launcher inside a gamescope session on the HOST, with the
  # in-box gamescope / virtual desktop off. A login shell puts the host's
  # gamescope on PATH (Ubuntu installs it to /usr/games). Returns 127 when
  # the host can't be reached, so the caller can fall back.
  inner="env DG_SORR_IN_HOST_GAMESCOPE=1 DG_SORR_GAMESCOPE= DG_SORR_DESKTOP_RES= $0"
  opts="${DG_SORR_HOST_GAMESCOPE_OPTS-{{ dg_sorr_host_gamescope_opts }}}"
  cmd="exec gamescope $opts -- distrobox-enter -n {{ dg_box_name }} -- $inner"
  if [ -n "${CONTAINER_ID:-}" ]; then
    command -v distrobox-host-exec >/dev/null 2>&1 || return 127
    # host-spawn runs in the caller's cwd, and box-only paths (/run/host/...)
    # don't exist on the host — the spawn then fails with 127.
    (cd / && distrobox-host-exec sh -lc "$cmd")
  else
    sh -lc "$cmd"
  fi
}

case "${1:-}" in
  status) status; exit 0 ;;
  stop) stop_game; exit 0 ;;
  *)
    if [ -n "${DG_SORR_HOST_GAMESCOPE-{{ _sorr_host_gamescope | bool | ternary('1', '') }}}" ] &&
       [ -z "${DG_SORR_IN_HOST_GAMESCOPE:-}" ]; then
      set +e
      run_in_host_gamescope
      rc=$?
      set -e
      [ "$rc" -ne 127 ] && exit "$rc"
      printf '%s\n' 'sorr-launch: host gamescope unavailable, launching in the box' >&2
      # In-box gamescope / the virtual desktop are what host mode replaces.
      export DG_SORR_GAMESCOPE="" DG_SORR_DESKTOP_RES=""
    fi
    run_with_exit_chord; exit $? ;;
esac

{# Players 1..dg_controller_players get the pad bindings on their own SDL
   index; the remaining slots keep only a Device line (unbound). #}
{% for p in range(1, 5) %}
[Wiimote{{ p }}]
{% if p <= dg_controller_players | int %}
Device = SDL/{{ p - 1 }}/{{ dg_controller_sdl_name }}
{% if p > 1 %}
Source = 1
{% endif %}
Buttons/A = `Button E`
Buttons/B = `Shoulder R`
Buttons/1 = `Button W`
Buttons/2 = `Button N`
Buttons/- = Back
Buttons/+ = Start
Buttons/Home = `Guide`
D-Pad/Up = `Pad N`
D-Pad/Down = `Pad S`
D-Pad/Left = `Pad W`
D-Pad/Right = `Pad E`
Extension = Nunchuk
IR/Up = `Right Y+`
IR/Down = `Right Y-`
IR/Left = `Right X-`
IR/Right = `Right X+`
Shake/X = `Thumb R`
Shake/Y = `Thumb R`
Shake/Z = `Thumb R`
Nunchuk/Buttons/C = `Shoulder L`
Nunchuk/Buttons/Z = `Trigger L`
Nunchuk/Stick/Up = `Left Y+`
Nunchuk/Stick/Down = `Left Y-`
Nunchuk/Stick/Left = `Left X-`
Nunchuk/Stick/Right = `Left X+`
Nunchuk/Stick/Calibration = 100.00 141.42 100.00 141.42 100.00 141.42 100.00 141.42
Nunchuk/Shake/X = `Thumb L`
Nunchuk/Shake/Y = `Thumb L`
Nunchuk/Shake/Z = `Thumb L`
{% else %}
Device = SDL/0/{{ dg_controller_sdl_name }}
{% endif %}
{% endfor %}
[BalanceBoard]
Device = SDL/0/{{ dg_controller_sdl_name }}
